# Copy to .env and fill in real values before deploying. Never commit .env.

# Supabase project (Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key — server-side only, bypasses RLS to insert moderated posts.
# NEVER ship this key in the iOS app; only the anon key goes on-device.
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# Hugging Face Inference API token (https://huggingface.co/settings/tokens)
# Used for toxic-bert + martin-ha toxicity scoring instead of self-hosting models.
HF_API_TOKEN=YOUR-HF-TOKEN

# Toxicity score threshold above which a post is rejected (0.0-1.0).
TOXICITY_THRESHOLD=0.6
